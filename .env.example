# Copy to .env and adjust. Every value is optional: without a .env file the
# platform runs fully offline with the demo keys below.

# --- Gemini (optional) -------------------------------------------------------
# With a key, the travel planner and support assistant use Gemini through
# function calling, and incident narratives are written by Gemini. Without it
# they use the built-in deterministic engines.
# A free key comes from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
RS_LLM_MODEL=gemini-3.8-flash
# Model for the optional LLM-as-judge faithfulness check on support answers
RS_LLM_JUDGE_MODEL=gemini-3.5-flash-lite
# Share of Gemini-generated support answers that also get the LLM judge (0-1)
RS_LLM_JUDGE_SAMPLE_RATE=0.2
# Use Gemini for simulated passenger traffic too (uses many requests; off by default)
RS_LLM_FOR_SYNTHETIC_TRAFFIC=false

# --- Security ----------------------------------------------------------------
# API keys as role:key pairs. Roles: passenger, operator, admin.
# CHANGE THESE before exposing the API on the internet.
RS_API_KEYS=passenger:rs-passenger-demo,operator:rs-operator-demo,admin:rs-admin-demo
RS_AUTH_ENABLED=true
# Secret used to sign explanation passports (HMAC-SHA256). Change it in production.
RS_PASSPORT_SECRET=rs-demo-passport-secret-change-me
# Passenger requests per minute per key and client IP
RS_RATE_LIMIT_PER_MINUTE=240

# --- Governance loop -----------------------------------------------------------
# Seconds between supervisor cycles inside the API process (0 disables the loop)
RS_SUPERVISOR_INTERVAL=45
# Simulate a batch of passenger traffic before each cycle so dashboards keep moving
RS_BACKGROUND_TRAFFIC=true

# --- Data ----------------------------------------------------------------------
# Where the SQLite database and model artifacts live (default: ./data)
RS_DATA_DIR=
# Training-set size multiplier for bootstrap (lower it on slow machines, e.g. 0.4)
RS_BOOTSTRAP_SCALE=1.0
RS_SEED=7

# --- Streamlit UI ----------------------------------------------------------------
RS_API_URL=http://localhost:8000
# Key the UI uses to call the API (admin so the Control Tower and Chaos Lab work)
RS_UI_API_KEY=rs-admin-demo
